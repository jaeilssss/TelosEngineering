{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/spec_gate.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\spec_gate.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking SPEC.md"
          }
        ]
      }
    ]
  }
}
